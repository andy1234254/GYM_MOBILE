<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GymSecretMobile.Views.RegistraClientePage"
             Title="Registro de Clientes"
             Shell.ForegroundColor="White"
             Shell.TitleColor="White"
             Shell.BackgroundColor="#0A0A0A"
             Shell.TabBarIsVisible="False" 
             Shell.NavBarIsVisible="True">

    <Grid>
        <Image Source="fondo_carbono.png" 
               Aspect="AspectFill" 
               HorizontalOptions="Fill" 
               VerticalOptions="Fill" />

        <ScrollView Padding="20">
            <VerticalStackLayout Spacing="18">

                <Border StrokeThickness="0" BackgroundColor="#80555555" StrokeShape="RoundRectangle 10" Padding="10,2">
                    <Entry x:Name="txtNombre" 
                           Placeholder="Nombre y Apellido" 
                           PlaceholderColor="#BBFFFFFF"
                           TextColor="White"
                           BackgroundColor="Transparent"/>
                </Border>

                <Border StrokeThickness="0" BackgroundColor="#80555555" StrokeShape="RoundRectangle 10" Padding="10,2">
                    <Entry x:Name="txtTelefono" 
                           Placeholder="Teléfono" 
                           Keyboard="Telephone" 
                           PlaceholderColor="#BBFFFFFF"
                           TextColor="White"
                           BackgroundColor="Transparent"/>
                </Border>

                <Border StrokeThickness="0" BackgroundColor="#80555555" StrokeShape="RoundRectangle 10" Padding="10,2">
                    <Picker x:Name="pckPlan" 
                            Title="Selecciona Plan..." 
                            TitleColor="#BBFFFFFF"
                            ItemDisplayBinding="{Binding Nombre}" 
                            TextColor="White" 
                            BackgroundColor="Transparent"
                            SelectedIndexChanged="OnPlanSeleccionado"/>
                </Border>

                <Button Text="+ Nuevo Plan" 
                        BackgroundColor="#4CAF50" 
                        TextColor="White" 
                        FontAttributes="Bold"
                        HorizontalOptions="Start" 
                        Clicked="OnNuevoPlanClicked"/>

                <VerticalStackLayout x:Name="slPareja" IsVisible="False" Spacing="8">
                    <Label Text="Buscar Pareja / Acompañante:" TextColor="#CCCCCC" FontSize="13" FontAttributes="Bold"/>

                    <Border StrokeThickness="0" BackgroundColor="#80555555" StrokeShape="RoundRectangle 10" Padding="10,2">
                        <SearchBar x:Name="searchPareja" 
                                   Placeholder="Escribe nombre..." 
                                   PlaceholderColor="#BBFFFFFF"
                                   TextChanged="OnSearchParejaTextChanged"
                                   TextColor="White"
                                   BackgroundColor="Transparent"
                                   CancelButtonColor="Red"/>
                    </Border>

                    <Border Stroke="#55FFFFFF" StrokeThickness="1" StrokeShape="RoundRectangle 10" IsVisible="False" x:Name="brdResultados" BackgroundColor="#CC2E2E2E">
                        <CollectionView x:Name="lstResultadosPareja" HeightRequest="150" SelectionMode="Single" 
                                        SelectionChanged="OnParejaSeleccionadaDeLista">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="12">
                                        <Label Text="{Binding NombreCompleto}" TextColor="White" VerticalOptions="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Border>

                    <Label x:Name="lblParejaSeleccionada" Text="Ninguna pareja seleccionada" 
                           TextColor="#66BB6A" FontAttributes="Italic" FontSize="13"/>
                </VerticalStackLayout>

                <Border StrokeThickness="1" 
                        Stroke="#80FFFFFF" 
                        StrokeShape="RoundRectangle 10" 
                        BackgroundColor="#80555555" 
                        HeightRequest="150" 
                        WidthRequest="150" 
                        HorizontalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTomarFotoTapped" />
                    </Border.GestureRecognizers>
                    <Grid>
                        <Image x:Name="imgPerfil" Aspect="AspectFill" />
                        <Image x:Name="iconoImg" Source="icono_foto.png" WidthRequest="50" Margin="10,0,5,0" VerticalOptions="Center"/>
                        <Label x:Name="lblFotoPlaceholder"                       
                               TextColor="#BBFFFFFF" 
                               HorizontalOptions="Center" 
                               VerticalOptions="Center" 
                               FontAttributes="Bold"/>
                    </Grid>
                </Border>
                <Border BackgroundColor="#CC2E2E2E" Padding="18" StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="#55FFFFFF">
                    <VerticalStackLayout Spacing="12">

                        <Label x:Name="lblPrecio" Text="Precio a cobrar: $-" TextColor="White" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center"/>

                        <BoxView HeightRequest="1" BackgroundColor="#44FFFFFF" Margin="0,5"/>

                        <Grid ColumnDefinitions="*, *" VerticalOptions="Center">
                            <Label Grid.Column="0" Text="Asistencias Totales:" TextColor="White" VerticalOptions="Center" FontSize="14"/>
                            <Border Grid.Column="1" StrokeThickness="0" BackgroundColor="#80555555" StrokeShape="RoundRectangle 8" Padding="8,2">
                                <Entry x:Name="txtAsistenciasEditables" 
                                       Keyboard="Numeric" 
                                       TextColor="White" 
                                       HorizontalTextAlignment="Center"
                                       BackgroundColor="Transparent"/>
                            </Border>
                        </Grid>

                        <Grid ColumnDefinitions="*, *" VerticalOptions="Center">
                            <Label Grid.Column="0" Text="Fecha Vencimiento:" TextColor="#4CAF50" FontAttributes="Bold" VerticalOptions="Center" FontSize="14"/>
                            <Border Grid.Column="1" StrokeThickness="0" BackgroundColor="#80555555" StrokeShape="RoundRectangle 8" Padding="8,2">
                                <DatePicker x:Name="dpFechaVencimiento" 
                                            TextColor="White" 
                                            Format="dd/MM/yyyy"
                                            BackgroundColor="Transparent"/>
                            </Border>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <Button Text="COBRAR Y GUARDAR" 
                        BackgroundColor="Black" 
                        TextColor="White" 
                        BorderColor="#55FFFFFF"
                        BorderWidth="1"
                        FontAttributes="Bold" 
                        CornerRadius="10" 
                        HeightRequest="55" 
                        Clicked="OnCobrarGuardarClicked"/>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>