<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:GymSecretMobile.Models"
             x:Class="GymSecretMobile.Views.PerfilClientePage"
             Title="Perfil de Cliente"
             Shell.ForegroundColor="White"
             Shell.TitleColor="White"
             Shell.BackgroundColor="#0A0A0A"
             Shell.TabBarIsVisible="False" 
             Shell.NavBarIsVisible="True">

    <Grid>

        <Image Source="fondo_carbono.png" 
               Aspect="AspectFill" 
               HorizontalOptions="Fill" 
               VerticalOptions="Fill" />

        <ScrollView Padding="20">
            <VerticalStackLayout Spacing="22">

                <Border Stroke="#55FFFFFF" 
        StrokeThickness="1" 
        StrokeShape="RoundRectangle 25" 
        BackgroundColor="#CC2E2E2E" 
        Padding="18">

                    <VerticalStackLayout Spacing="18">

                        <Grid ColumnDefinitions="*, 120" ColumnSpacing="15">

                            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Start">

                                <Grid ColumnDefinitions="*, 35">
                                    <Label x:Name="lblNombre" FontSize="22" FontAttributes="Bold" TextColor="White" VerticalOptions="Center"/>
                                    <Button Grid.Column="1" Text="✎" TextColor="White" BackgroundColor="#AA1E1E1E" Padding="8" HeightRequest="3" Clicked="OnEditNombreClicked"/>
                                </Grid>

                                <Grid ColumnDefinitions="*, 35">
                                    <Label x:Name="lblTelefono" TextColor="#CCCCCC" FontSize="14" VerticalOptions="Center"/>
                                    <Button Grid.Column="1" Text="✎" TextColor="White" BackgroundColor="#AA1E1E1E" HeightRequest="3" Padding="8" Clicked="OnEditTelefonoClicked"/>
                                </Grid>

                                <Grid ColumnDefinitions="*, 35">
                                    <Label x:Name="lblPlan" TextColor="#CCCCCC" FontSize="14" VerticalOptions="Center"/>
                                    <Button Grid.Column="1" Text="✎" TextColor="White" BackgroundColor="#AA1E1E1E" HeightRequest="3" Padding="8" Clicked="OnEditPlanClicked"/>
                                </Grid>

                                <Grid ColumnDefinitions="*, 35">
                                    <Label x:Name="lblPareja" TextColor="#CCCCCC" FontSize="14" VerticalOptions="Center"/>
                                    <Button Grid.Column="1" Text="✎" TextColor="White" BackgroundColor="#AA1E1E1E" HeightRequest="3" Padding="8" Clicked="OnEditParejaClicked"/>
                                </Grid>

                                <Grid ColumnDefinitions="*, 35">
                                    <Label x:Name="lblEstado" TextColor="#CCCCCC" FontSize="14" VerticalOptions="Center"/>
                                    <Button Grid.Column="1" Text="✎" TextColor="White" BackgroundColor="#AA1E1E1E" HeightRequest="3" Padding="8" Clicked="OnDesactivarClienteClicked"/>
                                </Grid>

                                <Grid ColumnDefinitions="*, 35">
                                    <Label x:Name="lblDias" TextColor="#CCCCCC" FontSize="14" VerticalOptions="Center"/>
                                    <Button Grid.Column="1" Text="✎" TextColor="White" BackgroundColor="#AA1E1E1E" HeightRequest="3" Padding="8" Clicked="OnEditDiasClicked"/>
                                </Grid>

                                
                            </VerticalStackLayout>

                            <Border Grid.Column="1" WidthRequest="120" HeightRequest="135" Stroke="#44FFFFFF" StrokeThickness="1" StrokeShape="RoundRectangle 12" VerticalOptions="Start" HorizontalOptions="Center">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnImagenPerfilTapped"/>
                                </Border.GestureRecognizers>
                                <Image x:Name="imgFoto" Aspect="AspectFill" />
                            </Border>

                        </Grid>
                        <Grid ColumnDefinitions="*, *" Margin="0,5">
                            <Label Grid.Column="0" Text="Fecha Registro:" TextColor="#CCCCCC" VerticalOptions="Center" FontSize="14"/>
                            <Border Grid.Column="1" StrokeThickness="0" BackgroundColor="#80555555" StrokeShape="RoundRectangle 8" Padding="8,2">
                                <DatePicker x:Name="dpRegistro" TextColor="White" Format="dd/MM/yyyy" BackgroundColor="Transparent" DateSelected="OnRegistroSelected"/>
                            </Border>
                        </Grid>

                        <Grid ColumnDefinitions="*, *" Margin="0,5">
                            <Label Grid.Column="0" Text="Último Pago:" TextColor="#CCCCCC" VerticalOptions="Center" FontSize="14"/>
                            <Border Grid.Column="1" StrokeThickness="0" BackgroundColor="#80555555" StrokeShape="RoundRectangle 8" Padding="8,2">
                                <DatePicker x:Name="dpUltimoPago" TextColor="White" Format="dd/MM/yyyy" BackgroundColor="Transparent" DateSelected="OnUltimoPagoSelected"/>
                            </Border>
                        </Grid>

                        <Grid ColumnDefinitions="*, *" Margin="0,5">
                            <Label Grid.Column="0" Text="Vencimiento:" TextColor="#CCCCCC" VerticalOptions="Center" FontSize="14"/>
                            <Border Grid.Column="1" StrokeThickness="0" BackgroundColor="#80555555" StrokeShape="RoundRectangle 8" Padding="8,2">
                                <DatePicker x:Name="dpVencimiento" TextColor="White" Format="dd/MM/yyyy" BackgroundColor="Transparent" DateSelected="OnVencimientoSelected"/>
                            </Border>
                        </Grid>

                        <Grid ColumnDefinitions="*, *, *, *" ColumnSpacing="8" Margin="0,15,0,0">
                            <Button Grid.Column="0" ImageSource="icono_repetir.png" BackgroundColor="#AA4CAF50" HeightRequest="44" CornerRadius="10" Clicked="OnRenovarClicked"/>
                            <Button Grid.Column="1" ImageSource="icono_foto.png" BackgroundColor="#AA0099FF" HeightRequest="44" CornerRadius="10" Clicked="OnActualizarFotoClicked"/>
                            <Button Grid.Column="2" ImageSource="icono_basura.png" BackgroundColor="#AAD32F2F" HeightRequest="44" CornerRadius="10" Clicked="OnEliminarClienteClicked"/>
                            <Button x:Name="btnGuardarEdicion" Grid.Column="3" ImageSource="icono_guardar.png" BackgroundColor="#AA9C27B0" HeightRequest="44" CornerRadius="10" Clicked="OnGuardarEdicionClicked" IsVisible="False"/>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center" Margin="2,0">
                    <Label Text="Historial de Asistencia:" 
                           TextColor="White" 
                           FontAttributes="Bold" 
                           FontSize="16" 
                           VerticalOptions="Center"/>

                    <Border Grid.Column="1" StrokeThickness="0" BackgroundColor="#80555555" StrokeShape="RoundRectangle 8" Padding="12,0">
                        <Picker x:Name="pckMes" 
                                Title="Seleccione Mes" 
                                TitleColor="#BBFFFFFF"
                                WidthRequest="140" 
                                HeightRequest="40"
                                SelectedIndexChanged="OnMesSeleccionado" 
                                TextColor="White" 
                                FontAttributes="Bold" />
                    </Border>
                </Grid>

                <Label x:Name="lblResumenAsistencia" 
                       Text="Total, días asistidos en el mes: 0" 
                       FontSize="15" 
                       TextColor="#4CAF50" 
                       FontAttributes="Bold" 
                       Margin="2,0"/>

                <VerticalStackLayout Spacing="0">
                    <Border StrokeShape="RoundRectangle 8,8,0,0" BackgroundColor="#AA1E1E1E" StrokeThickness="0">
                        <Grid ColumnDefinitions="*, *, *" Padding="10,12">
                            <Label Grid.Column="0" Text="Día" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center"/>
                            <Label Grid.Column="1" Text="Fecha" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center"/>
                            <Label Grid.Column="2" Text="Hora" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center"/>
                        </Grid>
                    </Border>

                    <BoxView HeightRequest="1" BackgroundColor="#44FFFFFF" />

                    <CollectionView x:Name="lstHistorial" HeightRequest="300">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Asistencia">
                                <SwipeView>
                                    <SwipeView.RightItems>
                                        <SwipeItems Mode="Reveal">
                                            <SwipeItem Text="Editar" 
                                   BackgroundColor="#AA0099FF" 
                                   Invoked="OnEditarAsistenciaClicked" />
                                            <SwipeItem Text="Eliminar" 
                                   BackgroundColor="#AAD32F2F" 
                                   Invoked="OnEliminarAsistenciaClicked" />
                                        </SwipeItems>
                                    </SwipeView.RightItems>

                                    <Grid ColumnDefinitions="*, *, *" Padding="10,12" BackgroundColor="Transparent">
                                        <Label Grid.Column="0" Text="{Binding FechaHora, StringFormat='{0:dddd}'}" TextColor="#EEEEEE" HorizontalTextAlignment="Center" VerticalOptions="Center"/>
                                        <Label Grid.Column="1" Text="{Binding FechaHora, StringFormat='{0:dd/MM/yyyy}'}" TextColor="#EEEEEE" HorizontalTextAlignment="Center" VerticalOptions="Center"/>
                                        <Label Grid.Column="2" Text="{Binding FechaHora, StringFormat='{0:HH:mm}'}" TextColor="#EEEEEE" HorizontalTextAlignment="Center" VerticalOptions="Center"/>
                                    </Grid>
                                </SwipeView>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <Grid x:Name="grdPantallaCompleta" IsVisible="False" BackgroundColor="Black">

            <Image x:Name="imgPantallaCompleta" 
           Aspect="AspectFit" 
           HorizontalOptions="Fill" 
           VerticalOptions="Fill"/>

            <Button Text="✕" 
            TextColor="White" 
            BackgroundColor="#80000000" 
            CornerRadius="20"
            WidthRequest="40" 
            HeightRequest="40"
            HorizontalOptions="End" 
            VerticalOptions="Fill" 
            Margin="20" 
            Clicked="OnCerrarPantallaCompletaClicked"/>
        </Grid>

        <Grid x:Name="gridEditor" IsVisible="False" BackgroundColor="#CC000000" VerticalOptions="Fill" HorizontalOptions="Fill">
            <Border VerticalOptions="Center" HorizontalOptions="Center" WidthRequest="300" BackgroundColor="#2C2C2C" StrokeThickness="0" StrokeShape="RoundRectangle 10">
                <StackLayout Spacing="15">
                    <Label Text="Editar Asistencia" FontAttributes="Bold" FontSize="18" TextColor="White"/>
                    <DatePicker x:Name="editDatePicker" Format="dd/MM/yyyy" TextColor="White"/>
                    <TimePicker x:Name="editTimePicker" TextColor="White"/>
                    <Button Text="Guardar Cambios" BackgroundColor="#4CAF50" Clicked="OnGuardarEdicionAsistenciaClicked"/>
                    <Button Text="Cancelar" BackgroundColor="#808080" Clicked="OnCancelarEdicionClicked"/>
                </StackLayout>
            </Border>
        </Grid>
    </Grid>
   
</ContentPage>